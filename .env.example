# Backend koneksi:
#   local = paket MetaTrader5 resmi, HANYA jalan di Windows (terminal MT5 satu mesin)
#   rpc   = lewat mt5linux, dipakai dari macOS ke server MT5 di Windows/Wine
MT5_BACKEND=rpc

# Kredensial akun MT5.
# Boleh dikosongkan kalau terminal MT5 sudah login manual: script akan
# memakai akun yang sedang aktif di terminal itu.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Backend local (opsional): path terminal64.exe kalau tidak terdeteksi otomatis
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Backend rpc: alamat mt5linux server
MT5_RPC_HOST=localhost
MT5_RPC_PORT=18812

# Simbol yang dicek saat verifikasi koneksi
MT5_SYMBOL=EURUSD

# Timeout tiap panggilan RPC (detik). initialize() pertama bisa lambat.
MT5_RPC_TIMEOUT=180

# --------------------------------------------------------------------------
# Trading (dipakai mt5_order.py)
# --------------------------------------------------------------------------

# Pengaman akun REAL. Selama "no", order ke akun uang sungguhan selalu ditolak;
# akun demo tetap jalan normal. Ubah ke "yes" hanya kalau memang disengaja --
# setelah itu tiap order live masih minta konfirmasi ketik "YA" (kecuali --yes).
MT5_ALLOW_LIVE=no

# Batas lot per order, pengaman salah ketik. Volume di atas ini selalu ditolak,
# demo maupun real.
MT5_MAX_LOT=1.0

# Slippage maksimum untuk order pasar, dalam poin.
MT5_DEVIATION=20

# Magic number penanda order dari script ini (biar mudah dibedakan dari order
# manual atau EA lain).
MT5_MAGIC=990215

# Komentar yang menempel di order. Dipotong otomatis di 31 karakter.
MT5_COMMENT=mt5_order.py

# --------------------------------------------------------------------------
# Pembacaan tren (dipakai mt5_trend.py)
# --------------------------------------------------------------------------

# Timeframe default yang dibaca, dipisah koma.
MT5_TREND_TF=M1,M5,M15

# Periode EMA cepat & lambat untuk menentukan arah.
MT5_TREND_EMA_CEPAT=20
MT5_TREND_EMA_LAMBAT=50

# ADX dipakai menyaring pasar menyamping. Di bawah ambang ini, timeframe
# dianggap SIDEWAYS berapa pun skor arahnya.
MT5_TREND_ADX_PERIODE=14
MT5_TREND_ADX_AMBANG=25

# Berapa bar ke belakang untuk mengukur kemiringan EMA dan struktur swing.
MT5_TREND_SLOPE_BAR=10
MT5_TREND_STRUKTUR_BAR=40

# Jumlah bar yang ditarik tiap timeframe.
MT5_TREND_BAR=600

# --------------------------------------------------------------------------
# Penyusunan setup (dipakai mt5_setup.py)
# --------------------------------------------------------------------------

# Timeframe dasar untuk ATR dan swing yang membentuk SL.
MT5_SETUP_TF=M5

# Persen equity yang dipertaruhkan per posisi. Ukuran lot dihitung dari sini,
# jadi angka ini yang sebenarnya menentukan berapa uang Anda berisiko.
MT5_RISIKO_PERSEN=1.0

# Kelipatan risk-reward untuk TP1 dan TP2.
MT5_RR=2.0
MT5_RR2=3.0

# Bantalan SL di luar swing terakhir, dalam kelipatan ATR.
MT5_SL_ATR_BANTALAN=0.3

# Lantai lebar SL dalam kelipatan ATR. Stop yang lebih sempit dari gerak
# normal pasar akan kena hanya karena riak biasa.
MT5_SL_ATR_MINIMAL=1.0

# Plafon lebar SL dalam kelipatan ATR. Tanpa ini, swing yang kebetulan jauh
# bisa melahirkan SL selebar puluhan dolar dan TP ikut melar karena kelipatan
# RR. Isi 0 untuk mematikan plafon (SL murni mengikuti struktur).
MT5_SL_ATR_MAKSIMAL=2.0

# Berapa bar ke belakang untuk mencari swing high/low pembentuk SL.
MT5_SWING_BAR=8

# Kelipatan risk-reward TP3, dipakai baris perintah scale-out 3 posisi.
MT5_RR3=4.0

# Berapa posisi dibuka perintah `mt5_order.py scale` ketika hanya SATU TP yang
# diisi (semua posisi berbagi SL dan TP yang sama). Dengan beberapa TP, jumlah
# posisi mengikuti panjang daftar TP dan angka ini tidak dipakai.
MT5_SCALE_LEGS=3

# Jarak antar harga masuk pada perintah `mt5_order.py scale`, dalam kelipatan
# ATR timeframe setup. Dipakai mt5_setup.py untuk menghitung --gap-points yang
# dicetak di PERINTAH SIAP PAKAI. Nilainya otomatis dipangkas kalau ladder-nya
# sampai memakan lebih dari separuh jarak ke SL.
MT5_SCALE_GAP_ATR=0.25

# Rentang default riwayat trade (hari ke belakang), dipakai mt5_history.py.
MT5_HISTORY_HARI=30

# --------------------------------------------------------------------------
# API riwayat trade (dipakai mt5_api.py)
# --------------------------------------------------------------------------

# Alamat dengar. Biarkan di 127.0.0.1 kecuali memang perlu diakses dari mesin
# lain -- riwayat trade adalah data finansial.
MT5_API_ADDR=127.0.0.1:8080

# Token Bearer. Wajib diisi kalau MT5_API_ADDR bukan localhost; server menolak
# jalan tanpa ini.
MT5_API_TOKEN=

# Nyalakan endpoint yang MENGUBAH akun (POST /order) di mt5_api.py. Mati
# secara bawaan. Wajib berpasangan dengan MT5_API_TOKEN yang terisi: server
# menolak start kalau endpoint order aktif tanpa token.
MT5_API_ALLOW_ORDER=no

# --------------------------------------------------------------------------
# Robot otomatis (dipakai mt5_bot.py)
# --------------------------------------------------------------------------

# Jeda antar putaran pemantauan, dalam detik.
MT5_BOT_INTERVAL=60

# Ambang kekuatan tren sebelum robot mau masuk. 0.5 setara label "KUAT" di
# mt5_trend.py. Makin tinggi makin jarang masuk, tapi makin selektif.
MT5_BOT_SKOR_MIN=0.5

# Maksimum posisi + order pending milik robot yang boleh hidup bersamaan.
MT5_BOT_MAX_POSISI=1

# Maksimum entry baru per hari. Pagar melawan overtrading saat pasar berisik.
MT5_BOT_MAX_TRADE_HARI=3

# Robot berhenti membuka posisi baru untuk sisa hari ini begitu rugi bersih
# hari berjalan menyentuh sekian persen equity.
MT5_BOT_RUGI_HARIAN_PERSEN=2.0

# Jeda wajib setelah entry terakhir, dalam detik. Mencegah robot menumpuk
# beberapa posisi pada satu gerakan yang sama.
MT5_BOT_COOLDOWN=300

# Batas spread (poin) sebelum robot menolak masuk. 0 = tidak dibatasi.
MT5_BOT_SPREAD_MAX=0

# Jam trading, format 08:00-22:00 (boleh melewati tengah malam: 22:00-06:00).
# Kosongkan untuk 24 jam.
MT5_BOT_JAM=
